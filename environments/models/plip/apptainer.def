# Generated from environments/models.yaml; do not edit by hand.
Bootstrap: docker
From: nvidia/cuda:12.6.3-cudnn-runtime-ubuntu22.04@sha256:5f0d2d827f6436b3cb7468fd8acbdc8c1d41261614e579ae49afe6141da51133

%files
    lock.txt /tmp/medumm-lock.txt

%post
    apt-get update
    apt-get install -y --no-install-recommends git python3.10 python3.10-venv python3-pip ca-certificates
    rm -rf /var/lib/apt/lists/*
    python3.10 -m venv /opt/medumm/venv
    /opt/medumm/venv/bin/python -m pip install --upgrade pip==25.1.1
    /opt/medumm/venv/bin/python -m pip install --extra-index-url https://download.pytorch.org/whl/cu126 -r /tmp/medumm-lock.txt

%environment
    export PATH=/opt/medumm/venv/bin:$PATH
    export PYTHONUNBUFFERED=1
    export HF_HOME=/cache/huggingface
    export MEDUMM_MODEL_ROOT=/models
    export MEDUMM_OUTPUT_ROOT=/outputs

%labels
    org.medumm.model plip
    org.medumm.profile contrastive_hf
    org.medumm.contract-sha256 3617f3f9cb5b821d71907b069a4c7cd0aefc6e1a87a4211cd5f80522b6324250
